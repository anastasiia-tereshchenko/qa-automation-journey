            "com"
          ],
          "path": [
            "v1",
            "forecast"
          ],
          "query": [
            {
              "key": "latitude",
              "value": "999"
            },
            {
              "key": "longitude",
              "value": "-0.1276"
            },
            {
              "key": "current",
              "value": "temperature_2m,relative_humidity_2m,wind_speed_10m"
            }
          ]
        }
      },
